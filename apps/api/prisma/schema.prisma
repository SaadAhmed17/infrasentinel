generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  invitations Invitation[]
  servers     Server[]
  rules       Rule[]
  incidents   Incident[]
}

enum ServerStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Server {
  id             String       @id @default(uuid())
  name           String
  hostname       String?
  apiKey         String       @unique
  status         ServerStatus @default(UNKNOWN)
  lastHeartbeat  DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  metrics        Metric[]
  alerts         Alert[]
  createdAt      DateTime     @default(now())
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

model Event {
  id             String        @id @default(uuid())
  eventType      String        // e.g. "AUTH_LOGIN_FAILURE" — plain string, extensible without migrations
  source         String        // e.g. "auth-service"
  severity       EventSeverity @default(INFO)
  message        String
  metadata       Json          // flexible per-event details (ipAddress, email, etc.)
  organizationId String?       // nullable: some events (bad login on unknown email) have no org yet
  createdAt      DateTime      @default(now())

  @@index([eventType, createdAt])
  @@index([organizationId, createdAt])
}

enum RuleType {
  METRIC_THRESHOLD
  EVENT_FREQUENCY
  HEARTBEAT_MISSING
  CREDENTIAL_STUFFING
  ANOMALY_DETECTION
}

enum MetricField {
  CPU_USAGE
  MEM_USAGE
  DISK_USAGE
}

enum ComparisonOperator {
  GREATER_THAN
  LESS_THAN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Rule {
  id              String              @id @default(uuid())
  name            String
  ruleType        RuleType

  // Used when ruleType = METRIC_THRESHOLD
  metricField     MetricField?
  operator        ComparisonOperator?
  threshold       Float?
  durationSeconds Int                 @default(60)

  // Used when ruleType = EVENT_FREQUENCY
  eventType       String?             // which event to count, e.g. "AUTH_LOGIN_FAILURE"
  groupByField    String?             // which metadata field to group by, e.g. "ipAddress"
  maxCount        Int?                // how many before it fires, e.g. 5
  windowSeconds   Int?                // within this many seconds, e.g. 600

  severity        Severity            @default(MEDIUM)
  isActive        Boolean             @default(true)
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  alerts          Alert[]
  createdAt       DateTime            @default(now())
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id         String      @id @default(uuid())
  ruleId     String
  rule       Rule        @relation(fields: [ruleId], references: [id])
  serverId   String?     // nullable: event-based alerts (e.g. login attacks) may not tie to one server
  server     Server?     @relation(fields: [serverId], references: [id])
  details    Json        // what actually triggered this (the value, the matching events, etc.)
  status     AlertStatus @default(OPEN)
  incidentId String?
  incident   Incident?   @relation(fields: [incidentId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([status, createdAt])
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model Incident {
  id             String         @id @default(uuid())
  title          String
  severity       Severity
  status         IncidentStatus @default(OPEN)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  alerts         Alert[]
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?
}

model Metric {
  id            String   @id @default(uuid())
  serverId      String
  server        Server   @relation(fields: [serverId], references: [id])
  cpuUsage      Float
  memUsage      Float
  diskUsage     Float
  networkIn     Float?
  networkOut    Float?
  diskReadRate  Float?
  diskWriteRate Float?
  processCount  Int?
  loadAverage   Float?
  timestamp     DateTime @default(now())

  @@index([serverId, timestamp])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Invitation {
  id             String            @id @default(uuid())
  email          String
  role           Role              @default(VIEWER)
  token          String            @unique
  status         InvitationStatus  @default(PENDING)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
}

enum Role {
  OWNER
  ADMIN
  SECURITY_ANALYST
  DEVOPS_ENGINEER
  DEVELOPER
  VIEWER
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  role           Role         @default(VIEWER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
}