# Address of the web app, used in password reset links
WEB_APP_URL=http://localhost:3000
# SMTP server for password reset emails, e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=<your Gmail address>, SMTP_PASS=<a Google app password, not your normal password>.
# Without SMTP_HOST the API prints reset links in its terminal instead (local development only).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown in the email; defaults to SMTP_USER
SMTP_FROM=