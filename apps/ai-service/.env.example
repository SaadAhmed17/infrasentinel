DATABASE_URL="postgresql://neondb_owner:<YOUR_NEON_DATABASE_PASSWORD>@ep-misty-heart-aiczm5vm-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
PORT = 8000
GROQ_API_KEY = your_groq_api_key_here
GROQ_MODEL = openai/gpt-oss-120b
# Shared secret the API must send (x-internal-secret header); same value as AI_SERVICE_SHARED_SECRET in apps/api/.env.
# Every endpoint except /health is refused without it.
AI_SERVICE_SHARED_SECRET = <LONG_RANDOM_SECRET>